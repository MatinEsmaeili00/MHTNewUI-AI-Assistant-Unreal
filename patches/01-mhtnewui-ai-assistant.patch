+void UIHPCAssistantComp::AddAuthHeader(const TSharedRef<IHttpRequest, ESPMode::ThreadSafe>& HttpRequest) const
+{
+	const FString Key = GetApiKey();
+	if (!Key.IsEmpty())
+	{
+		HttpRequest->SetHeader(TEXT("Authorization"), TEXT("Bearer ") + Key);
