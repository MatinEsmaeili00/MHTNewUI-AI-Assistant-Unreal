+UCPP_MouseFunctionComp* UIHPCAssistantComp::GetCamera() const
+{
+	const APawn* Avatar = GetAvatar();
+	return Avatar ? Avatar->FindComponentByClass<UCPP_MouseFunctionComp>() : nullptr;
+}
