+			FSlateApplication::Get().ProcessMouseButtonUpEvent(Up);
+		}
+	}), FMath::Max(Seconds, 0.01f), /*bLoop*/ false);
+}
+
+void UCPP_UW_IHPCSideBar::HandleBotHoldTimer()
+{
+	if (!bBotPressed || bBotHolding)
